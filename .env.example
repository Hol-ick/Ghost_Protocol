# ══════════════════════════════════════════════
# Ghost Protocol — 환경 변수 템플릿
# 이 파일을 복사하여 .env 로 저장 후 실제 값을 입력하세요.
# .env 파일은 절대 Git에 커밋되지 않습니다.
# ══════════════════════════════════════════════

# Default: original Gemini API workflow. Store the key in local .env only.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_TIMEOUT_SEC=90

# API mode always uses the full original prompt/persona, not local draft cards.
# Optional historical local adapter (used only with LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_MODELS=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=120
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=10m

# Prompt/grammar tuning for local writing.  This example keeps the 3B default;
# set OLLAMA_NUM_CTX=8192 (or leave it unset) when switching to qwen2.5:7b.
LLM_PROMPT_MODE=auto
LLM_JSON_SCHEMA_MODE=0

# LLM execution guardrails (shared by API and optional local mode)
LLM_MAX_CALLS_PER_RUN=120
LLM_COST_SAVER_MODE=1
LLM_JUDGE_MODE=auto
LLM_JUDGE_SAMPLE_RATE=0.35
LLM_TREND_CACHE_TTL_SEC=900
LLM_CALL_MIN_INTERVAL_SEC=0.15
LLM_CALL_JITTER_SEC=0.05
LLM_MAX_REFILL_ROUNDS=2
